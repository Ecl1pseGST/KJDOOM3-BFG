+/***********************************************************************
+
+	KJ: Prone / crawl / dive.
+
+	Mirrors the crouch chain above exactly - Legs_Prone/Legs_Unprone are the
+	down/up transitions, Legs_Proned is the stationary idle, Legs_ProneCrawl(_Backward)
+	are the moving states. Legs_Dive is the dolphin-dive variant that skips the
+	crouch tier entirely and drops straight into Legs_Proned.
+
+	PLACEHOLDER ANIMATIONS: none of the real prone/crawl/dive .md5anim clips
+	exist yet, so every playAnim/playCycle call below reuses the existing
+	crouch anim names as a stand-in. Swapping to the real animations later is
+	just changing the literal anim name string in each call - see the "anim"
+	declarations in player.def for where those names resolve to files.
+
+***********************************************************************/
+
+void player::Legs_Prone() {
+	playAnim( ANIMCHANNEL_LEGS, "crouch_down" );		// KJ: placeholder - should be "prone_down"
+
+	while( !animDone( ANIMCHANNEL_LEGS, 4 ) ) {
+		if ( !AI_PRONE ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Unprone", 4 );
+		}
+		waitFrame();
+	}
+	
+	animState( ANIMCHANNEL_LEGS, "Legs_Proned", 4 );
+}
+
+void player::Legs_Proned() {
+	weapon_changed = false;
+	playCycle( ANIMCHANNEL_LEGS, "crouch" );			// KJ: placeholder - should be "prone"
+
+	eachFrame {
+		if ( !AI_PRONE ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Unprone", 4 );
+		}
+		if ( AI_FORWARD ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+		if ( AI_BACKWARD ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl_Backward", 4 );
+		}
+		if ( AI_STRAFE_LEFT ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+		if ( AI_STRAFE_RIGHT ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+		if ( AI_JUMP ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Jump", 4 );
+		}
+		if ( weapon_changed ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Proned", 4 );
+		}
+	}
+}
+
+void player::Legs_ProneCrawl() {
+	weapon_changed = false;
+	playCycle( ANIMCHANNEL_LEGS, "crouch_walk" );		// KJ: placeholder - should be "prone_crawl"
+
+	eachFrame {
+		if ( !AI_PRONE ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Unprone", 4 );
+		}
+		if ( AI_JUMP ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Jump", 4 );
+		}
+		// KJ: unlike Legs_Proned, this one DOES check ground contact - crawling off
+		// a ledge should visibly fall, whereas Proned deliberately doesn't check this
+		// since it needs to persist through an in-progress mid-air dive.
+		if ( !AI_ONGROUND ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Fall", 4 );
+		}
+		if ( AI_BACKWARD && !AI_FORWARD ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl_Backward", 4 );
+		}
+		if ( !AI_FORWARD && !AI_STRAFE_LEFT && !AI_STRAFE_RIGHT ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Proned", 4 );
+		}
+		if ( weapon_changed ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+	}
+}
+
+void player::Legs_ProneCrawl_Backward() {
+	weapon_changed = false;
+	playCycle( ANIMCHANNEL_LEGS, "crouch_walk_backwards" );	// KJ: placeholder - should be "prone_crawl_backward"
+
+	eachFrame {
+		if ( !AI_PRONE ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Unprone", 4 );
+		}
+		if ( AI_JUMP ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Jump", 4 );
+		}
+		if ( !AI_ONGROUND ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Fall", 4 );
+		}
+		if ( AI_FORWARD && !AI_BACKWARD ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+		if ( !AI_BACKWARD && !AI_STRAFE_LEFT && !AI_STRAFE_RIGHT ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Proned", 4 );
+		}
+		if ( weapon_changed ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_ProneCrawl", 4 );
+		}
+	}
+}
+
+void player::Legs_Unprone() {
+	playAnim( ANIMCHANNEL_LEGS, "crouch_up" );			// KJ: placeholder - should be "prone_up"
+
+	while( !animDone( ANIMCHANNEL_LEGS, 4 ) ) {
+		waitFrame();
+	}
+	
+	animState( ANIMCHANNEL_LEGS, "Legs_Crouched", 4 );
+}
+
+void player::Legs_Dive() {
+	// KJ: skips the crouch tier entirely - lands straight in Legs_Proned. Works
+	// identically whether triggered grounded or airborne (see CheckDuck()'s dive
+	// branch), since nothing here checks AI_ONGROUND.
+	playAnim( ANIMCHANNEL_LEGS, "crouch_down" );		// KJ: placeholder - should be a unique "dive_to_prone"
+
+	while( !animDone( ANIMCHANNEL_LEGS, 4 ) ) {
+		if ( !AI_PRONE ) {
+			animState( ANIMCHANNEL_LEGS, "Legs_Unprone", 4 );
+		}
+		waitFrame();
+	}
+	
+	animState( ANIMCHANNEL_LEGS, "Legs_Proned", 4 );
+}
