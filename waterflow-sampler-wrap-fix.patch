-				desc[1].bindings[0].resourceHandle = commonPasses.m_LinearClampSampler;
+				desc[1].bindings[0].resourceHandle = commonPasses.m_LinearWrapSampler;
+				desc[1].bindings[1].resourceHandle = commonPasses.m_LinearClampSampler;
 			}
 		}
